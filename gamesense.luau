local http = game:GetService("HttpService")
local function copyMap(map)
    local result = {}
    for k,v in map or {} do result[tostring(k)] = v end
    return result
end

local function snapshot(scope)
    local data = {version=1,scope=scope,items={},layout={}}
    for tab,groups in tabs do
        if scope == 0 or scope == tab then
            for index,group in groups do
                table.insert(data.layout,{tab,index,offsets.layout[group] or {0,0,0,0}})
                for _,d in group.items do
                    data.items[tostring(d.id)] = {values[d.id],modes[d.id]}
                end
            end
        end
    end
    if scope <= 1 then
        data.enabled = copyMap(enabledWeapons)
        data.profiles = {}
        for weapon,profile in weaponProfiles do data.profiles[tostring(weapon)] = copyMap(profile) end
    end
    if scope == 0 or scope == 2 then
        data.yaw = {copyMap(offsets[64]),copyMap(offsets[68])}
    end
    return data
end

local function integer(v,min,max)
    return type(v) == "number" and v%1 == 0 and v >= min and v <= max
end

local function verifyItem(d,row)
    assert(type(row) == "table")
    local value,mode = row[1],row[2]
    if d.kind == "Checkbox" then assert(type(value) == "boolean")
    elseif d.kind == "Slider" then assert(integer(value,d.lo,d.hi))
    elseif d.kind == "Hotkey" then assert(type(value) == "string" and #value <= 64 and integer(mode,0,3))
    elseif d.kind == "ColorPicker" then assert(integer(value,0,4294967295))
    elseif d.kind == "Textbox" then assert(value == d.value or type(value) == "string")
    elseif d.values then
        if d.multi then
            local mask = 0
            for _,flag in d.values do mask = bit32.bor(mask,flag) end
            assert(integer(value,0,4294967295) and bit32.band(value,mask) == value)
        else assert(table.find(d.values,value) or value == d.value) end
    else assert(value == d.value) end
end

local function restore(data,scope)
    assert(data.version == 1 and data.scope == scope)
    local items,layout,profiles,enabled,yaw = {},{},{},{},{}
    for tab,groups in tabs do
        if scope == 0 or scope == tab then
            for _,group in groups do
                for _,d in group.items do
                    local row = data.items[tostring(d.id)]
                    verifyItem(d,row)
                    items[d.id] = row
                end
            end
        end
    end
    for _,entry in data.layout do
        local tab,index,coords = entry[1],entry[2],entry[3]
        assert(integer(tab,1,#tabs) and (scope == 0 or tab == scope) and integer(index,1,#tabs[tab]))
        for i=1,4 do assert(integer(coords[i],-100000,100000)) end
        layout[tabs[tab][index]] = coords
    end
    if scope <= 1 then
        for k,v in data.enabled do
            local id = tonumber(k)
            assert(integer(id,0,11) and type(v) == "boolean")
            enabled[id] = v
        end
        for k,rows in data.profiles do
            local id = tonumber(k)
            assert(integer(id,0,11))
            profiles[id] = {}
            for _,d in tabs[1][2].items do
                local row = rows[tostring(d.id)]
                verifyItem(d,row)
                profiles[id][d.id] = row
            end
        end
    end
    if scope == 0 or scope == 2 then
        for i,id in {64,68} do
            yaw[id] = {}
            for k,v in data.yaw[i] do
                local mode = tonumber(k)
                assert(integer(mode,0,5) and integer(v,-180,180))
                yaw[id][mode] = v
            end
        end
    end
    for id,row in items do values[id],modes[id] = row[1],row[2] end
    for group,coords in layout do offsets.layout[group] = coords end
    if scope <= 1 then enabledWeapons,weaponProfiles = enabled,profiles end
    for id,map in yaw do offsets[id] = map end
    dpi = 1+values[360]*0.25
    fit()
    render()
end

local function configBlob(scope,encoded)
    local crypto = crypt
    assert(crypto and crypto.encrypt and crypto.decrypt and crypto.base64encode and crypto.base64decode,"Crypto unavailable")
    local key = "DUS8tCMUEuAZL6/cf8vUHnZjKrUo4tTjQ7RLYEoTNck="
    if encoded then
        assert(#encoded <= 524288)
        local envelope = http:JSONDecode(crypto.base64decode(encoded))
        assert(envelope[1] == "GS1")
        local json = crypto.decrypt(envelope[3],key,envelope[2],"CBC")
        restore(http:JSONDecode(json),scope)
        return
    end
    local cipher,iv = crypto.encrypt(http:JSONEncode(snapshot(scope)),key,nil,"CBC")
    assert(type(cipher) == "string" and type(iv) == "string")
    return crypto.base64encode(http:JSONEncode({"GS1",iv,cipher}))
end

transfer = function(anchor,scope,importing)
    local panel = popupAt(anchor,266,76)
    local message = text(panel,7,2,252,17,importing and "Paste the exported code" or "Copy the exported code")
    local box = field(panel,7,22,252,20,"")
    local button = text(panel,7,48,252,20,importing and "Import" or "Copy",true,"TextButton")
    if not importing then
        local ok,blob = pcall(configBlob,scope)
        if not ok then message.Text = "Export failed. Check crypto support." return end
        box.Text = blob
        box.TextEditable = false
    end
    button.MouseButton1Click:Connect(function()
        if importing then
            local ok = pcall(configBlob,scope,box.Text:match("^%s*(.-)%s*$"))
            if not ok then message.Text = "Invalid code, wrong tab, or missing crypto." end
        elseif setclipboard and pcall(setclipboard,box.Text) then
            message.Text = "Copied"
        else
            box:CaptureFocus()
            box.CursorPosition = #box.Text+1
            box.SelectionStart = 1
        end
    end)
end

local function picker(anchor,d)
