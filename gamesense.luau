local iconAtlas
pcall(function()
    local pixels = buffer.create(700*400*4)
    for offset=0,buffer.len(pixels)-4,4 do buffer.writeu32(pixels,offset,0x00ffffff) end
    for i,data in detailedSprites do
        local ox,oy = (i-1)%5*140+2,math.floor((i-1)/5)*100+2
        eachRun(data[3],function(x,y,w,rgba)
            local index = ((oy+y)*700+ox+x)*4
            for j=0,w-1 do buffer.writeu32(pixels,index+j*4,bit32.byteswap(rgba)) end
        end)
    end
    iconAtlas = imageContent(700,400,pixels)
end)

local function sprite(parent, index, x, y, opacity)
    local data = sprites[index]
    if iconAtlas then
        local icon = make("ImageLabel",parent,math.round(x),math.round(y),data[1],data[2])
        icon.ImageContent = Content.fromObject(iconAtlas)
        icon.ImageRectOffset = Vector2.new((index-1)%5*140+2,math.floor((index-1)/5)*100+2)
        local detail = detailedSprites[index]
        icon.ImageRectSize = Vector2.new(detail[1],detail[2])
        icon.ImageTransparency = 1-opacity
        return icon
    end
    local canvas = make("CanvasGroup",parent,math.round(x),math.round(y),data[1],data[2])
    canvas.GroupTransparency = 1-opacity
    eachRun(data[3],function(px,py,w,rgba)
        local alpha = bit32.band(rgba,255)
        if alpha > 0 then rect(canvas,px,py,w,1,bit32.rshift(rgba,8)).BackgroundTransparency = 1-alpha/255 end
    end)
    return canvas
end

