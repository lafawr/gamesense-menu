    local alpha = bit32.extract(values[d.id],24,8)/255
    local plane = rect(panel,6,6,140,130,0xffffff)
    local saturation = gradient(plane,0xffffff,0xffffff)
    saturation.Rotation = 0
    local shade = rect(plane,0,0,140,130,0)
    local darkness = Instance.new("UIGradient")
    darkness.Rotation = 90
    darkness.Transparency = NumberSequence.new(1,0)
    darkness.Parent = shade
    local strip = rect(panel,152,6,18,130,0xffffff)
    local rainbow = gradient(strip,0xff0000,0xff0000)
    local stops = {}
    for i=0,6 do table.insert(stops,ColorSequenceKeypoint.new(i/6,Color3.fromHSV(i/6,1,1))) end
    rainbow.Color = ColorSequence.new(stops)
    local opacity = surface(panel,6,143,164,12,0x303030,0x111111)
    local marker = rect(plane,0,0,4,4,0xffffff)
    marker.BorderSizePixel = 1
    marker.BorderColor3 = rgb(0)
    local hueMark = rect(strip,0,0,18,2,0xffffff)
    local alphaMark = rect(opacity,0,0,2,12,0xffffff)
    local function update()
        saturation.Color = ColorSequence.new(Color3.new(1,1,1),Color3.fromHSV(hue,1,1))
        local c = Color3.fromHSV(hue,sat,val)
        marker.Position = UDim2.fromOffset(sat*136,(1-val)*126)
        hueMark.Position = UDim2.fromOffset(0,hue*128)
        alphaMark.Position = UDim2.fromOffset(alpha*162,0)
        values[d.id] = math.round(alpha*255)*2^24 + tonumber(c:ToHex(),16)
        anchor.BackgroundColor3 = c
    end
    for _, control in {plane,strip,opacity} do
        local hit = text(control,0,0,control.Size.X.Offset,control.Size.Y.Offset,"",false,"TextButton")
        hit.MouseButton1Down:Connect(function(x,y)
            drag = function(px,py)
                local fx = math.clamp((px-hit.AbsolutePosition.X)/hit.AbsoluteSize.X,0,1)
                local fy = math.clamp((py-hit.AbsolutePosition.Y)/hit.AbsoluteSize.Y,0,1)
                if control == plane then sat,val = fx,1-fy elseif control == strip then hue = fy else alpha = fx end
                update()
            end
            drag(x,y)
        end)
    end
    update()
end

