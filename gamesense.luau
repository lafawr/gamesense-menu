local function rgb(n)
    return Color3.fromRGB(bit32.extract(n, 16, 8), bit32.extract(n, 8, 8), bit32.extract(n, 0, 8))
end

local function make(class, parent, x, y, w, h, color)
    local object = Instance.new(class)
    object.BorderSizePixel = 0
    object.Position = UDim2.fromOffset(x, y)
    object.Size = UDim2.fromOffset(w, h)
    if color then object.BackgroundColor3 = rgb(color) else object.BackgroundTransparency = 1 end
    object.Parent = parent
    return object
end

local function rect(parent, x, y, w, h, color)
    return make("Frame", parent, x, y, w, h, color)
end

local assetService = game:GetService("AssetService")
local tile
local function imageContent(w,h,pixels)
    local image = assetService:CreateEditableImage({Size=Vector2.new(w,h)})
    image:WritePixelsBuffer(Vector2.zero,Vector2.new(w,h),pixels)
    return image
end
pcall(function()
    local pattern = "..x.x.x.x...x.x."
    local texels = buffer.create(64)
    for i=0,15 do
        buffer.writeu32(texels,i*4,pattern:sub(i+1,i+1)=="x" and 0xff0c0c0c or 0xff141414)
    end
    tile = imageContent(4,4,texels)
end)

local tweenService = game:GetService("TweenService")
local function animate(object, duration, target)
    local tween = tweenService:Create(object,TweenInfo.new(duration,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),target)
    tween:Play()
    return tween
end

local function text(parent, x, y, w, h, caption, bold, class, instant)
    local object = make(class or "TextLabel", parent, x, y, w, h)
    object.Font = bold and Enum.Font.ArialBold or Enum.Font.Arial
    object.TextSize = 12
    object.TextColor3 = rgb(0xcdcdcd)
    object.TextXAlignment = Enum.TextXAlignment.Left
    object.Text = caption
    if object:IsA("TextButton") then
        object.AutoButtonColor = false
        if instant then return object end
        local glow = make("Frame",object,0,0,0,0,0xffffff)
        glow.Size = UDim2.fromScale(1,1)
        glow.BackgroundTransparency = 1
        local function tint(alpha)
            if object.Interactable then animate(glow,0.1,{BackgroundTransparency=alpha}) end
        end
        object.MouseEnter:Connect(function() tint(0.94) end)
        object.MouseLeave:Connect(function() tint(1) end)
        object.MouseButton1Down:Connect(function() tint(0.87) end)
        object.MouseButton1Up:Connect(function() tint(0.94) end)
    end
    return object
end

local function gradient(object, first, last)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new(rgb(first), rgb(last))
    gradient.Rotation = 90
    gradient.Parent = object
    return gradient
end

local function surface(parent, x, y, w, h, top, bottom)
    local edge = rect(parent, x, y, w, h, 0x0c0c0c)
    local face = rect(edge,1,1,w-2,h-2,0xffffff)
    face.Size = UDim2.new(1,-2,1,-2)
    gradient(face,top,bottom)
    return edge
end

local function eachRun(data, draw)
    for i=1,#data,14 do
        local geometry = tonumber(data:sub(i,i+5),16)
        local rgba = tonumber(data:sub(i+6,i+13),16)
        draw(bit32.extract(geometry,16,8),bit32.extract(geometry,8,8),bit32.extract(geometry,0,8),rgba)
    end
end

