local function formatValue(d)
    local v = values[d.id]
    if d.tips and d.tips[v] then return d.tips[v] end
    if d.hp and v > 100 then return "HP+"..(v-100) end
    return tostring(tonumber(string.format("%.3f",v*d.step)))..d.unit
