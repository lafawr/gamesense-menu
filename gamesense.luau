            b.MouseButton2Click:Connect(function() weaponContext(b,values[id]) end)
            local art = sprites[9+values[id]]
            sprite(b,9+values[id],bw-art[1]-28,(bh-art[2])/2,0.8).Position = UDim2.new(1,-art[1]-28,0.5,-art[2]/2)
            surface(b,18,bh/2-4,8,8,enabledWeapons[values[id]] and 0x9eca2a or 0x484848,0x343434).Position = UDim2.new(0,18,0.5,-4)
        end
        b.MouseButton1Click:Connect(function()
            choices(b,d.options,selected,function(i)
                if d.multi then
                    setValue(d,bit32.bxor(values[id],d.values[i]))
                    desc.Text = selection()
                    for _,row in popup:GetChildren() do
                        if row:IsA("TextButton") then
                            local n=math.floor(row.Position.Y.Offset/20)+1
                            row.TextColor3 = selected(n) and rgb(values[359]) or rgb(0xcdcdcd)
                        end
                    end
                else change(d,d.values[i]) end
            end,weapon and 30 or 20,d.multi,weapon and function(row,i)
                local weaponId = d.values[i]
                row.Text = "         "..d.options[i]
                row.MouseButton2Click:Connect(function() weaponContext(b,weaponId) end)
                local toggle = text(row,4,0,22,30,"",false,"TextButton")
                local mark = surface(toggle,7,11,8,8,enabledWeapons[weaponId] and 0x9eca2a or 0x484848,0x343434)
                toggle.MouseButton1Click:Connect(function()
                    enabledWeapons[weaponId] = not enabledWeapons[weaponId]
                    mark:Destroy()
                    mark = surface(toggle,7,11,8,8,enabledWeapons[weaponId] and 0x9eca2a or 0x484848,0x343434)
                end)
                local art = sprites[9+d.values[i]]
                sprite(row,9+d.values[i],bw-art[1]-24,(30-art[2])/2,0.65).Position = UDim2.new(1,-art[1]-24,0.5,-art[2]/2)
            end or nil)
        end)
        return weapon and 0 or dy+20
    elseif kind == "Button" then
        local edge = surface(controls,x,y,span,25,0x242424,0x1e1e1e)
        edge.Size = UDim2.new(1,0,0,25)
        local b = text(edge,0,0,span,25,label,false,"TextButton")
        b.Size = UDim2.fromScale(1,1)
        b.TextXAlignment = Enum.TextXAlignment.Center
        b.Interactable = not off
        b.MouseButton1Click:Connect(function()
            if id == 368 then table.clear(scroll) table.clear(offsets.layout) render()
            elseif id == 369 then unload() end
        end)
        return 28
    elseif kind == "Textbox" then
        local box = field(controls,x,y,span,20,type(values[id])=="string" and values[id] or "")
        box.Size = UDim2.new(1,0,0,20)
        box.FocusLost:Connect(function() values[id] = box.Text end)
        return 20
    elseif kind == "Listbox" then
        local box = surface(controls,x,y,span,d.height,0x202020,0x181818)
        box.Size = UDim2.new(1,0,0,d.height)
        if d.search then
            local search = field(box,1,1,span-2,17,scroll["query"..id] or "")
            search.Size = UDim2.new(1,-2,0,17)
            search.FocusLost:Connect(function() scroll["query"..id] = search.Text end)
        end
        return d.height
    end
end

offsets.layout = {}
local reflow = {}
local function groups()
    table.clear(reflow)
    local columns = {}
    for _, group in tabs[current] do
        local top = 20+(columns[group.x] or 0)
        local layout = offsets.layout[group] or {0,0,0,0}
        local function bounds()
            local availW,availH = width-109,height-16-top
            return 102+math.floor(group.x*availW/24)+layout[1],
                top+10+math.floor(group.y*availH/24)+layout[2],
                math.max(130,math.floor(group.w*availW/24)-20+layout[3]),
                math.max(45,(group.fixed or math.floor(group.h*availH/24)-20)+layout[4])
        end
        local x,y,w,h = bounds()
        if group.fixed then
            for col=group.x,group.x+group.w-1 do columns[col]=group.fixed+20 end
        end
        local frame = rect(content,x,y,w+1,h+1,0x0c0c0c)
        rect(frame,1,1,w-1,h-1,0x282828).Size = UDim2.new(1,-2,1,-2)
        local body = make("ScrollingFrame",frame,2,2,w-3,h-3,0x171717)
        body.Size = UDim2.new(1,-4,1,-4)
        body.ScrollBarThickness = 5
        body.ScrollBarImageColor3 = rgb(0x494949)
        body.ScrollingDirection = Enum.ScrollingDirection.Y
        local controls = make("Frame",body,0,0,0,0)
        controls.Size = UDim2.new(1,-97,0,0)
        local limit = Instance.new("UISizeConstraint")
        limit.MinSize = Vector2.new(40,0)
        limit.MaxSize = Vector2.new(200,0)
        limit.Parent = controls
        local cur,row = 18,18
        for _, d in group.items do
            if visible[d.id] then
                if d.kind == "Hotkey" or d.kind == "ColorPicker" then
                    widget(body,d,row+1,w,h,controls)
                else
                    row = cur
                    cur += widget(body,d,cur,w,h,controls)+5
                end
            end
        end
        if group.title == "Settings" then
            for index,label in {"Export configuration","Import configuration"} do
                local edge = surface(controls,38,cur,1,25,0x242424,0x1e1e1e)
                edge.Size = UDim2.new(1,0,0,25)
                local action = text(edge,0,0,0,0,label,false,"TextButton")
                action.Size = UDim2.fromScale(1,1)
                action.TextXAlignment = Enum.TextXAlignment.Center
                action.MouseButton1Click:Connect(function() transfer(action,0,index == 2) end)
                cur += 33
            end
        end
        body.CanvasSize = UDim2.fromOffset(0,cur>h-7 and cur+18 or 0)
        body.CanvasPosition = Vector2.new(0,scroll[group] or 0)
        body:GetPropertyChangedSignal("CanvasPosition"):Connect(function() scroll[group]=body.CanvasPosition.Y end)
        local title = text(frame,12,-7,0,14," "..group.title.." ",true,"TextButton")
        title.Active = not values[366] and not group.locked
        title.AutomaticSize = Enum.AutomaticSize.X
        title.BackgroundTransparency = 0
        title.BackgroundColor3 = rgb(0x171717)
        local function resizeGroup()
            x,y,w,h = bounds()
            frame.Position = UDim2.fromOffset(x,y)
            frame.Size = UDim2.fromOffset(w+1,h+1)
            body.CanvasSize = UDim2.fromOffset(0,cur>h-7 and cur+18 or 0)
        end
        table.insert(reflow,resizeGroup)
        if not values[366] and not group.locked then
            title.MouseButton1Down:Connect(function(mx,my)
                local a,b = layout[1],layout[2]
                drag = function(px,py)
                    layout[1],layout[2] = a+math.round((px-mx)/scale.Scale),b+math.round((py-my)/scale.Scale)
                    frame.Position = UDim2.fromOffset(x+layout[1]-a,y+layout[2]-b)
                    offsets.layout[group] = layout
                end
            end)
            local grip = text(frame,w-10,h-11,10,11,"",false,"TextButton")
            grip.Position = UDim2.new(1,-11,1,-12)
            for k=1,5 do rect(grip,9-k,4+k,k,1,0x414141) end
            grip.MouseButton1Down:Connect(function(mx,my)
                local a,b = layout[3],layout[4]
                resizing = true
                local startW,startH = w,h
                drag = function(px,py)
                    layout[3]=a+math.max(130-startW,math.round((px-mx)/scale.Scale))
                    layout[4]=b+math.max(45-startH,math.round((py-my)/scale.Scale))
                    offsets.layout[group]=layout
                    resizeGroup()
                end
            end)
        end
    end
end

function render(transition)
    close()
    capture = nil
    rules()
    if transition then
        local previous = content
        previous.Interactable = false
        local outgoing = previous.Parent
        if outgoing == shell then
            outgoing = make("CanvasGroup",shell,0,0,width,height)
            outgoing.Size = UDim2.fromScale(1,1)
            previous.Parent = outgoing
        end
        local leaving = animate(outgoing,0.11,{GroupTransparency=1,Position=UDim2.fromOffset(-3,0)})
        leaving.Completed:Once(function() outgoing:Destroy() end)
        local incoming = make("CanvasGroup",shell,4,0,width,height)
        incoming.Size = UDim2.fromScale(1,1)
        incoming.GroupTransparency = 1
        content = make("Frame",incoming,0,0,width,height)
        content.Size = UDim2.fromScale(1,1)
    else
        content:ClearAllChildren()
    end
    local selectedY = 10+(current-1)*64
    animate(sidebarTop,0.14,{Size=UDim2.fromOffset(75,selectedY)})
    animate(sidebarBottom,0.14,{Position=UDim2.fromOffset(0,selectedY+64),Size=UDim2.new(0,75,1,-16-selectedY-64)})
    for i,icon in icons do tintIcon(icon,i==current and 0 or 0.61) end
    groups()
    if transition then
        local page = content
        local layer = page.Parent
        local entering = animate(layer,0.15,{GroupTransparency=0,Position=UDim2.fromOffset(0,0)})
        entering.Completed:Once(function(state)
            if state == Enum.PlaybackState.Completed and page == content and page.Parent == layer then
                page.Parent = shell
                layer:Destroy()
            end
        end)
    end
end

function change(d,v)
    setValue(d,v)
    if d.id == 360 then dpi = 1+v*0.25 end
    fit()
    render()
end

local connections = {}
local function connect(signal, callback)
    table.insert(connections,signal:Connect(callback))
end
connect(gui:GetPropertyChangedSignal("AbsoluteSize"),fit)
local function inside(object,pos)
    local delta = Vector2.new(pos.X,pos.Y)-object.AbsolutePosition
    return delta.X>=0 and delta.Y>=0 and delta.X<object.AbsoluteSize.X and delta.Y<object.AbsoluteSize.Y
end
local fadeTween, fadeLayer
local open = true
local unloading = false
local function toggle()
    if unloading and not open then return end
    open = not open
    close()
    capture,drag,resizing = nil,nil,false
    if fadeTween then fadeTween:Cancel() end
    gui.Enabled = true
    root.Interactable = false
    if not fadeLayer then
        fadeLayer = make("CanvasGroup",root,0,0,width,height)
        fadeLayer.Size = UDim2.fromScale(1,1)
        fadeLayer.GroupTransparency = open and 1 or 0
        shell.Parent = fadeLayer
    end
    local target = open and 0 or 1
    local tween = tweenService:Create(fadeLayer,TweenInfo.new(0.15*math.abs(fadeLayer.GroupTransparency-target),Enum.EasingStyle.Linear),{GroupTransparency=target})
    fadeTween = tween
    tween.Completed:Once(function(state)
        if fadeTween ~= tween or state ~= Enum.PlaybackState.Completed then return end
        fadeTween = nil
        shell.Parent = root
        fadeLayer:Destroy()
        fadeLayer = nil
        root.Interactable = open
        gui.Enabled = open
        if unloading then gui:Destroy() end
    end)
    tween:Play()
end
unload = function()
    if unloading then return end
    unloading = true
    if open then
        toggle()
    elseif not fadeTween then
        gui:Destroy()
    end
end
connect(input.InputBegan,function(event)
    if unloading then return end
    if not capture and not input:GetFocusedTextBox() and event.KeyCode == Enum.KeyCode.End then
        unload()
        return
    end
    if capture then
        local key = event.KeyCode.Name
        if event.UserInputType == Enum.UserInputType.Keyboard or event.UserInputType.Name:match("^MouseButton") then
            local target = capture
            if key == "Unknown" then key = event.UserInputType.Name end
            change(target,key=="Escape" and "" or key)
        end
        return
    end
    if input:GetFocusedTextBox() then return end
    if values[357] == event.KeyCode.Name or values[357] == event.UserInputType.Name then
        toggle()
        return
    end
    if fadeTween or not gui.Enabled or event.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if popup then
        if not inside(popup,event.Position) then close() render() end
        return
    end
    if not inside(root,event.Position) then return end
    local rel = (Vector2.new(event.Position.X,event.Position.Y)-root.AbsolutePosition)/scale.Scale
    local initial = root.Position
    local start = event.Position
    if rel.X>=width-10 and rel.Y>=height-10 then
        local w,h=width,height
        local factor = scale.Scale
        resizing = true
        local topLeft = root.AbsolutePosition
        drag=function(px,py)
            width = math.clamp(w+math.round((px-start.X)/factor),669,math.max(w,math.floor(gui.AbsoluteSize.X/factor)))
            height = math.clamp(h+math.round((py-start.Y)/factor),564,math.max(h,math.floor(gui.AbsoluteSize.Y/factor)))
            root.Size=UDim2.fromOffset(width,height)
            root.Position = UDim2.fromOffset(topLeft.X+width*factor/2,topLeft.Y+height*factor/2)
            for _,update in reflow do update() end
        end
    else
        for _,hit in playerGui:GetGuiObjectsAtPosition(start.X,start.Y) do
            if hit:IsDescendantOf(root) and hit.Visible then
                if (hit:IsA("GuiButton") and hit.Active) or hit:IsA("TextBox") then return end
                if hit:IsA("ScrollingFrame") and hit.ScrollBarThickness > 0
                    and start.X >= hit.AbsolutePosition.X+hit.AbsoluteSize.X-hit.ScrollBarThickness*scale.Scale then return end
            end
        end
        resizing = true
        drag=function(px,py) root.Position=initial+UDim2.fromOffset(px-start.X,py-start.Y) end
    end
end)
connect(input.InputChanged,function(event)
    if drag and event.UserInputType==Enum.UserInputType.MouseMovement then drag(event.Position.X,event.Position.Y) end
end)
connect(input.InputEnded,function(event)
    if drag and event.UserInputType==Enum.UserInputType.MouseButton1 then
        drag=nil
        if resizing then resizing = false return end
        if popup then return end
        render()
    end
end)
gui.Destroying:Connect(function()
    unloading = true
    for _,connection in connections do connection:Disconnect() end
    if fadeTween then fadeTween:Cancel() end
    if iconAtlas then iconAtlas:Destroy() end
    if tile then tile:Destroy() end
    drag,capture,popup=nil,nil,nil
end)
framing()
fit()
render()
open = false
toggle()
